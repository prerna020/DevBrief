# Root .env: read by packages/db, services/ai-engine, apps/github-app and apps/worker.
# You do not fill this in by hand: setup.ps1 and setup-github-app.ps1 write it.
# See LOCAL_SETUP.md.

# --- Written by setup.ps1 ---------------------------------------------------

# Neon (free) connection string. A local docker Postgres will NOT work because
# packages/db forces SSL.
DATABASE_URL=

# Encrypts users' LLM provider keys in the database (base64 of 32 random bytes).
# Must be identical in apps/web/.env.local.
ENCRYPTION_KEY=

# Shared secret between the worker and ai-engine.
INTERNAL_SERVICE_TOKEN=

# Max diff size (chars) the ai-engine will review.
MAX_DIFF_CHARS=40000

REDIS_URL=redis://localhost:6379

# --- Written by setup-github-app.ps1 ----------------------------------------

APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
AI_ENGINE_URL=http://localhost:8000
SANDBOX_ENABLED=false

# --- Optional: repo-wide context (reviews work without these) ---------------

# Pinecone Starter plan is free. Lets reviews also see related files of the repo.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=devbrief
# Free key from https://atlas.nomic.ai, used for embeddings.
NOMIC_API_KEY=
