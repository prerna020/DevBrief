# apps/github-app/.env is created for you by setup-github-app.ps1
# (Probot's setup wizard writes these after you click "Create GitHub App").

APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# GitHub App client credentials. Also used by the dashboard sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# smee.io relays GitHub's webhooks to your laptop (local development only).
WEBHOOK_PROXY_URL=

# Run the receiver on 3002 so it does not clash with the dashboard on 3000.
PORT=3002
LOG_LEVEL=info
