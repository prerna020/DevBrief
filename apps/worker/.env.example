# The worker reads the repo-root .env (written by setup.ps1 and
# setup-github-app.ps1). You normally do not need this file. Values here
# override the root .env.

# APP_ID, PRIVATE_KEY      GitHub App credentials (from setup-github-app.ps1)
# INTERNAL_SERVICE_TOKEN   shared secret with ai-engine (from setup.ps1)
# REDIS_URL, AI_ENGINE_URL queue and AI engine addresses

# Local use: leave false. The sandbox clones repos and lints Python, and needs
# Linux tools. Reviews work without it.
SANDBOX_ENABLED=false
